# =============================================================================
# Dynamic AI Chatbot — Backend Environment Configuration Template
# =============================================================================
# Copy this file to .env and adjust as needed.
# =============================================================================

# ── Application Environment ──────────────────────────────────────────────────
# LOCALHOST / DOCKER (Default):
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=INFO

# PRODUCTION (Uncomment when deploying to cloud like Render):
# APP_ENV=production
# APP_DEBUG=false
# LOG_LEVEL=WARNING

APP_NAME=Dynamic AI Chatbot
APP_HOST=0.0.0.0
APP_PORT=8000

# ── Google Gemini API Key ────────────────────────────────────────────────────
# Free key from: https://aistudio.google.com/app/apikey
# Leave empty for free demo mode
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
# LOCALHOST / DOCKER (Default):
DATABASE_URL=postgresql+asyncpg://chatbot:chatbot_pass@localhost:5432/chatbot_db

# PRODUCTION (Neon.tech free PostgreSQL):
# DATABASE_URL=postgresql+asyncpg://neondb_owner:YOUR_PASSWORD@ep-xyz.us-east-2.aws.neon.tech/neondb?ssl=require

# ── Redis Cache ──────────────────────────────────────────────────────────────
# LOCALHOST / DOCKER (Default):
REDIS_URL=redis://localhost:6379/0

# PRODUCTION (Upstash free Redis):
# REDIS_URL=rediss://default:YOUR_PASSWORD@xyz.upstash.io:6379

# ── CORS Allowed Origins ─────────────────────────────────────────────────────
# LOCALHOST / DOCKER (Default):
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# PRODUCTION (Replace with your deployed frontend URL):
# CORS_ORIGINS=https://your-chatbot-frontend.vercel.app

# ── Security ─────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-secure-random-string-in-production
RATE_LIMIT_PER_MINUTE=60
MAX_MESSAGE_LENGTH=5000

# ── AI Orchestrator Settings ─────────────────────────────────────────────────
DEFAULT_TEMPERATURE=0.7
MAX_CONTEXT_MESSAGES=20
MAX_RESPONSE_TOKENS=2048
ENABLE_STREAMING=true
ENABLE_RAG=true
ENABLE_TOOLS=true

# ── Vector Store (PostgreSQL pgvector) ───────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2
VECTOR_DIMENSION=384
